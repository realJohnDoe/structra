{
  "name": "structra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "examples:regen": "node scripts/examples-regen.ts",
    "test:e2e": "playwright test",
    "check": "pnpm run lint && pnpm --dir parsers/typescript run typecheck && uv run --project parsers/python --frozen ty check parsers/python && pnpm test && pnpm run build && uv run --project parsers/python --frozen pytest && pnpm --dir parsers/typescript test && pnpm run test:e2e",
    "readme:diagram": "node scripts/readme-diagram.ts",
    "readme:stills": "playwright test --config playwright.stills.config.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "^0.3.1",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@12.21.0"
}
